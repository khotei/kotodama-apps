{
  "$schema": "https://biomejs.dev/schemas/2.5.2/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!**/dist",
      "!**/storybook-static",
      "!**/schema.gen.ts",
      "!**/tokens.gen.ts",
      "!**/tokens.css"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded",
      "trailingCommas": "all"
    }
  },
  "linter": {
    "enabled": true,
    "domains": {
      "react": "recommended"
    },
    "rules": {
      "preset": "recommended",
      "correctness": {
        "noUnusedImports": "error"
      },
      "suspicious": {
        "noExplicitAny": "error"
      },
      "style": {
        "useImportType": "error"
      }
    }
  },
  "overrides": [
    {
      "includes": ["packages/api-client/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@kotodama/*"],
                    "message": "Layer violation: packages/api-client is the transport base — it imports NO internal package (only openapi-fetch + its own generated schema.gen). See frontend-layering.md."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/ui/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@kotodama/*"],
                    "message": "Leaf violation: packages/ui is the design-system leaf (Chakra + tokens + components) — it imports NOTHING internal and takes data via props. See frontend-layering.md."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["repositories/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@kotodama/store",
                      "@kotodama/use-cases",
                      "@kotodama/ui",
                      "@kotodama/web"
                    ],
                    "message": "Layer violation: repositories may depend on @kotodama/api-client only — never store/use-cases, the design system, or apps."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["store/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@kotodama/use-cases", "@kotodama/ui", "@kotodama/web"],
                    "message": "Layer violation: store composes repositories + core into queryOptions — it must not import use-cases, the design system, or apps. It is platform-agnostic spine."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["use-cases/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@kotodama/repositories", "@kotodama/ui", "@kotodama/web"],
                    "message": "Layer violation: use-cases reach data through @kotodama/store, never repositories directly; and never the design system or apps. (api-client types are fine — it is a leaf package.) Keep it DOM-free."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/web/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@kotodama/repositories", "@kotodama/repositories/**"],
                    "message": "Layer violation: apps/web reaches data through @kotodama/use-cases hooks (or @kotodama/store loaders), never the raw fetchX in repositories. See frontend-layering.md."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
