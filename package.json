{
  "name": "kotodama-frontend",
  "private": true,
  "packageManager": "bun@1.3.10",
  "workspaces": [
    "apps/*",
    "core",
    "packages/*"
  ],
  "catalogs": {
    "runtime": {
      "typescript": "^5.9.0",
      "bun-types": "^1.3.0",
      "@types/node": "^22.10.0",
      "@types/react": "^19.2.0"
    },
    "react": {
      "react": "^19.2.0",
      "react-dom": "^19.2.0",
      "@types/react-dom": "^19.2.0",
      "server-only": "^0.0.1",
      "react-use": "^17.6.1"
    },
    "next": {
      "next": "^16.2.10",
      "babel-plugin-react-compiler": "^1.0.0"
    },
    "tanstack": {
      "@tanstack/react-form": "^1.33.0"
    },
    "style": {
      "tailwindcss": "^4.1.0",
      "@tailwindcss/postcss": "^4.1.0",
      "@tailwindcss/vite": "^4.1.0",
      "class-variance-authority": "^0.7.1",
      "clsx": "^2.1.1",
      "tailwind-merge": "^3.3.0",
      "radix-ui": "^1.6.1",
      "@radix-ui/react-slot": "^1.2.3",
      "lucide-react": "^0.475.0",
      "next-themes": "^0.4.6",
      "cmdk": "^1.1.1",
      "sonner": "^2.0.7"
    },
    "ui": {
      "storybook": "^10.4.0",
      "@storybook/react-vite": "^10.4.0",
      "vite": "^8.1.0"
    },
    "api": {
      "openapi-typescript": "^7.13.0",
      "openapi-fetch": "^0.17.0",
      "zod": "^4.4.0"
    },
    "test": {
      "vitest": "^4.1.0",
      "jsdom": "^29.0.0",
      "@vitejs/plugin-react": "^6.0.0",
      "@testing-library/react": "^16.3.0",
      "@testing-library/dom": "^10.4.0",
      "@testing-library/jest-dom": "^6.9.0",
      "@playwright/test": "^1.61.0"
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@kotodama/tooling": "workspace:*",
    "@testing-library/dom": "catalog:test",
    "@testing-library/jest-dom": "catalog:test",
    "@testing-library/react": "catalog:test",
    "bun-types": "catalog:runtime",
    "husky": "^9.1.7",
    "jsdom": "catalog:test",
    "typescript": "catalog:runtime",
    "vitest": "catalog:test",
    "@vitejs/plugin-react": "catalog:test"
  },
  "scripts": {
    "prepare": "husky",
    "bootstrap": "bun install",
    "format": "biome format --write --config-path packages/tooling/biome.base.json .",
    "lint": "biome lint --config-path packages/tooling/biome.base.json .",
    "tsc": "bun run --filter '*' typecheck",
    "test": "bun run --filter '*' test",
    "check": "bun run lint && bun run tsc",
    "gen:api": "bun run --filter '@kotodama/api-client' gen:api"
  }
}
