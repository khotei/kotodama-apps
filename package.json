{
  "name": "kotodama-frontend",
  "private": true,
  "packageManager": "bun@1.3.10",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "catalogs": {
    "runtime": {
      "typescript": "^5.9.0",
      "bun-types": "^1.3.0",
      "@types/node": "^22.10.0",
      "@types/react": "^19.2.0"
    },
    "react": {
      "react": "^19.2.0",
      "react-dom": "^19.2.0",
      "@types/react-dom": "^19.2.0"
    },
    "tanstack": {
      "@tanstack/react-router": "^1.170.0",
      "@tanstack/react-query": "^5.101.0",
      "@tanstack/react-form": "^1.33.0"
    },
    "ui": {
      "@chakra-ui/react": "^3.36.0",
      "@ark-ui/react": "^5.37.0",
      "storybook": "^10.4.0",
      "@storybook/react-vite": "^10.4.0",
      "vite": "^8.1.0"
    },
    "api": {
      "openapi-typescript": "^7.13.0",
      "openapi-fetch": "^0.17.0",
      "zod": "^4.4.0"
    },
    "test": {
      "vitest": "^3.2.0",
      "jsdom": "^29.0.0",
      "@testing-library/react": "^16.3.0",
      "@testing-library/dom": "^10.4.0",
      "@testing-library/jest-dom": "^6.9.0"
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@testing-library/dom": "catalog:test",
    "@testing-library/jest-dom": "catalog:test",
    "@testing-library/react": "catalog:test",
    "bun-types": "catalog:runtime",
    "husky": "^9.1.7",
    "jsdom": "catalog:test",
    "typescript": "catalog:runtime",
    "vitest": "catalog:test"
  },
  "scripts": {
    "prepare": "husky",
    "bootstrap": "bun install",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "tsc": "bun run --filter '*' typecheck",
    "test": "bun run --filter '*' test",
    "check": "bun run lint && bun run tsc",
    "new-package": "bun --bun scripts/new-package.ts"
  }
}
