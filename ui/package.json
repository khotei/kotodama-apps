{
  "name": "@kotodama/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles.css",
    "./fixtures": "./src/fixtures/index.ts",
    "./lib/*": "./src/lib/*.ts",
    "./components/*": "./src/components/*.tsx"
  },
  "scripts": {
    "typecheck": "bun --bun tsc --noEmit",
    "test": "bun --bun vitest run",
    "storybook:dev": "bunx --bun storybook dev -p 6006 --no-open",
    "build-storybook": "bunx --bun storybook build"
  },
  "dependencies": {
    "class-variance-authority": "catalog:style",
    "clsx": "catalog:style",
    "cmdk": "catalog:style",
    "lucide-react": "catalog:style",
    "next-themes": "catalog:style",
    "radix-ui": "catalog:style",
    "sonner": "catalog:style",
    "tailwind-merge": "catalog:style"
  },
  "peerDependencies": {
    "react": "catalog:react",
    "react-dom": "catalog:react"
  },
  "devDependencies": {
    "@kotodama/presets": "workspace:*",
    "@storybook/addon-a11y": "catalog:ui",
    "@storybook/addon-mcp": "catalog:ui",
    "@storybook/react-vite": "catalog:ui",
    "@tailwindcss/vite": "catalog:style",
    "@types/react": "catalog:runtime",
    "@types/react-dom": "catalog:react",
    "react": "catalog:react",
    "react-dom": "catalog:react",
    "storybook": "catalog:ui",
    "tailwindcss": "catalog:style",
    "vite": "catalog:ui"
  }
}
