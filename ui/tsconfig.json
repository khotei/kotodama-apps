{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@kotodama/presets/tsconfig.dom.json",
  "compilerOptions": {
    "outDir": "dist",
    "jsx": "react-jsx",
    "types": ["bun-types", "@types/react", "@testing-library/jest-dom/vitest"],
    "paths": {
      "@kotodama/ui": ["./src/index.ts"],
      "@kotodama/ui/*": ["./src/*"]
    }
  },
  "include": ["src/**/*", "test/**/*", ".storybook/**/*", "*.config.ts"]
}
