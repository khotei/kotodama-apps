  },
  "peerDependencies": {
    "react": "catalog:react",
    "react-dom": "catalog:react"
  },
  "devDependencies": {
    "@types/react": "catalog:runtime",
    "@types/react-dom": "catalog:react",
    "react": "catalog:react",
    "react-dom": "catalog:react",
    "tailwindcss": "catalog:style",
    "storybook": "catalog:ui",
    "@storybook/react-vite": "catalog:ui",
    "vite": "catalog:ui"
  }
