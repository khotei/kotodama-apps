{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "lib": ["dom", "dom.iterable", "esnext"],
    "jsx": "react-jsx",
    "types": ["bun-types", "@types/react"],
    "paths": {
      "@kotodama/ui/*": ["./src/*"]
    }
  },
  "include": [
    "src/**/*",
    "test/**/*",
    ".storybook/**/*",
    "*.config.ts",
    "../../testing-matchers.d.ts"
  ]
}
