{
  "$schema": "https://biomejs.dev/schemas/2.5.2/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!**/dist",
      "!**/storybook-static",
      "!**/schema.gen.ts",
      "!**/tokens.gen.ts",
      "!**/tokens.css"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded",
      "trailingCommas": "all"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "linter": {
    "enabled": true,
    "domains": {
      "react": "recommended"
    },
    "rules": {
      "preset": "recommended",
      "correctness": {
        "noUnusedImports": "error"
      },
      "suspicious": {
        "noExplicitAny": "error"
      },
      "style": {
        "useImportType": "error"
      }
    }
  },
  "overrides": [
    {
      "includes": ["packages/api-client/**", "!packages/api-client/gen-api.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@kotodama/*"],
                    "message": "Layer violation: packages/api-client is the transport base — it imports NO internal package (only openapi-fetch + its own generated schema.gen). The gen-api.ts build script is exempt (it may reuse @kotodama/config's loadRootEnv). See frontend-layering.md."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/ui/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@kotodama/*"],
                    "message": "Leaf violation: packages/ui is the design-system leaf (Tailwind + shadcn primitives + tokens) — it imports NOTHING internal and takes data via props. See frontend-layering.md."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["repositories/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@kotodama/store", "@kotodama/core", "@kotodama/ui", "@kotodama/web"],
                    "message": "Layer violation: repositories may depend on @kotodama/api-client only — never store, core, the design system, or apps."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["store/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@kotodama/core", "@kotodama/ui", "@kotodama/web"],
                    "message": "Layer violation: store derives domain models over repositories — it must not import core, the design system, or apps. It is platform-agnostic spine."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["core/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@kotodama/use-cases",
                      "@kotodama/repositories",
                      "@kotodama/config",
                      "@kotodama/web",
                      "next",
                      "next/**"
                    ],
                    "message": "Layer violation: core is the web-only domain tier — composable domain-aware pieces over @kotodama/ui + @kotodama/store, composed by use-cases. It must not reach up into use-cases or apps, nor into repositories/config/next. See frontend-layering.md."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["use-cases/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@kotodama/repositories",
                      "@kotodama/config",
                      "@kotodama/web",
                      "next",
                      "next/**"
                    ],
                    "message": "Layer violation: use-cases is the web-only feature tier — it composes @kotodama/ui + @kotodama/store into prop-driven assemblies. It must stay Next-free (the app injects loaders/actions/URLs as serializable props) and must not reach repositories, config, or apps. See frontend-layering.md."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/web/**"],
      "linter": {
        "domains": {
          "next": "recommended"
        },
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@kotodama/repositories", "@kotodama/repositories/**"],
                    "message": "Layer violation: only apps/web/src/server (the RSC data layer) may touch raw fetchX in repositories. Render code reaches data through the src/server loaders. See frontend-layering.md."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/web/src/server/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@kotodama/ui", "@kotodama/use-cases", "@kotodama/web"],
                    "message": "Layer violation: the RSC data layer (apps/web/src/server) composes repositories + store models + config into loaders and actions — it must not import the design system or use-cases. Presentation lives in @kotodama/use-cases."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
