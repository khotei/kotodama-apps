# Web app environment. Copy to `.env` for local dev (`.env` is gitignored).
# Validated once in apps/web/src/env.ts — a missing or non-URL value fails the
# build, there is no silent localhost default. Build per environment.

# Backend origin (kotodama-core) the Next rewrites proxy `/api/*` to, and the
# server clients call. Core owns port 3000.
KOTODAMA_API_URL=http://localhost:3000

# This Next app's OWN public origin — resolves metadataBase, robots.txt, and
# sitemap.xml URLs. Distinct from the backend: dev runs Next on 3001 (`next dev
# -p 3001`) so it doesn't collide with core on 3000.
KOTODAMA_SITE_URL=http://localhost:3001
