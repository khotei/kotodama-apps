# Kotodama frontend environment. Copy to `.env` at the repo root (git-ignored)
# for local dev. Loaded as a FALLBACK by @kotodama/config's `loadRootEnv` — real
# exported / deploy-injected vars always win, and on a server with no file we run
# purely on the process env. Every key is optional in the schema and required at
# its point of use. Build per environment.

# Backend origin (kotodama-core) the Next rewrites proxy `/api/*` to, and the
# server clients call. Core owns port 3000.
KOTODAMA_API_URL=http://localhost:3000

# This Next app's OWN public origin — resolves metadataBase, robots.txt, and
# sitemap.xml URLs. Dev runs Next on 4000 so it doesn't collide with core on 3000.
KOTODAMA_SITE_URL=http://localhost:4000
